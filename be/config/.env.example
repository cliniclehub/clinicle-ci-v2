# -----------------------------------------------------------------------------
# Application name and service name
# -----------------------------------------------------------------------------
ENVIRONMENT=local
SERVICE_NAME=ci_app-backend

# Local listen port for `make run-be` (change when 8000 is already in use).
PORT=8000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_SCHEMA=ci
DATABASE_URL=postgresql://ci_user:ci_user@localhost:5432/ci_db

# -----------------------------------------------------------------------------
# Database pool (optional; code defaults shown)
# STATEMENT_TIMEOUT is seconds (not milliseconds).
# -----------------------------------------------------------------------------
POOL_CLASS=QueuePool
POOL_SIZE=5
MAX_OVERFLOW=10
POOL_TIMEOUT=30
POOL_RECYCLE=3600
POOL_PRE_PING=true
CONNECT_TIMEOUT=10
STATEMENT_TIMEOUT=300
ECHO=false
ECHO_POOL=false

# -----------------------------------------------------------------------------
# Logging (local defaults are verbose; non-local defaults are quieter)
# -----------------------------------------------------------------------------
LOG_LEVEL=DEBUG
LOG_HTTP_HEADERS=true
LOG_HTTP_BODIES=true
LOG_JSON=false

# -----------------------------------------------------------------------------
# Auth token lifetimes and lockout (values below are the code defaults)
# -----------------------------------------------------------------------------
# Same value as fe/.env.local JWT_PUBLIC_OR_SECRET. Generate >=32 random characters.
AUTH2_SECRET_KEY=f758477076a7141567778169335d176f7624f1800974d393c455998811574804
AUTH2_ALGORITHM=HS256
AUTH2_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH2_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH2_EMAIL_VERIFICATION_EXPIRE_MINUTES=15
AUTH2_PASSWORD_RESET_EXPIRE_MINUTES=15
AUTH2_MAX_LOGIN_ATTEMPTS=5
AUTH2_LOCKOUT_DURATION_MINUTES=15
AUTH2_PASSWORD_HISTORY_CHECK_DEPTH=5


# -----------------------------------------------------------------------------
# Cron schedulers run options in process or external
# -----------------------------------------------------------------------------
ENABLE_INLINE_SCHEDULERS=false

# -----------------------------------------------------------------------------
# Email delivery
# Keep false until a mail provider is configured. Emails still render and queue.
# MAILERSEND_API_KEY is MailerSend-specific, not generic SMTP. Switching to
# SendGrid/SES/etc. needs a new provider class in be/app/common/email_providers/.
# -----------------------------------------------------------------------------
EMAIL_DELIVERY_ENABLED=false
DEFAULT_SYSTEM_FROM_EMAIL=no-reply@example.test
DEFAULT_SENDER_FROM_EMAIL=sender@example.test
MAILERSEND_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Object storage (Cloudflare R2 and S3 compatible).
# Not plug-and-play for Google Cloud Storage; code changes are required.
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BUCKET_NAME=
R2_MEDIA_SERVER_WORKER_URL=
R2_PUBLIC_MEDIA_SERVER_WORKER_URL=
# Optional. Falls back to AUTH2_SECRET_KEY.
# MEDIA_ACCESS_TOKEN_SECRET=
MEDIA_ACCESS_TOKEN_EXPIRE_MINUTES=25
MEDIA_ACCESS_TOKEN_ALGORITHM=HS256






