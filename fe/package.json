    "test:cov:broad": "cross-env FE_COV_INCLUDE_COMPONENTS=1 vitest run --coverage --config vitest.config.ts",
    "test:log-rotation": "node scripts/test-log-rotation.js",
    "verify:logs": "node scripts/verify-log-rotation.js",
    "check:i18n": "node scripts/check-i18n-keys.js"
