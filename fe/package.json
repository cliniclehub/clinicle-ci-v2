{
  "name": "ci-app-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=6144 next dev",
    "dev:turbo": "cross-env NODE_OPTIONS=--max-old-space-size=6144 next dev --turbopack",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=6144 next build",
    "analyze": "cross-env ANALYZE=true NODE_OPTIONS=--max-old-space-size=6144 next build",
