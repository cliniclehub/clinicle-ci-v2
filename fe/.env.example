# Copy to fe/.env.local (gitignored). Never commit real secrets.

# -----------------------------------------------------------------------------
# Application name and service name
# -----------------------------------------------------------------------------
ENVIRONMENT=local
SERVICE_NAME=ci_app-frontend

# Local listen port for `make run-fe` / `make start-fe` (change when 3000 is already in use).
# Next.js reads PORT natively. If you browse via localhost (not Caddy), also update
# NEXT_PUBLIC_BASE_URL below to match (e.g. http://localhost:3001).
PORT=3000

NEXT_PUBLIC_APP_NAME=Clinicle Intelligence App
NEXT_PUBLIC_ENVIRONMENT=local

# Via Caddy (recommended): keep clinicle-ci.local hosts — Caddy proxies to PORT/BE PORT.
# Direct localhost: set these to your chosen FE/BE ports, e.g.
#   NEXT_PUBLIC_BASE_URL=http://localhost:3001
#   NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_BASE_URL=https://admin.clinicle-ci.local
NEXT_PUBLIC_BACKEND_API_URL=https://api.clinicle-ci.local/api/v1

# -----------------------------------------------------------------------------
# Logging (local defaults are verbose)
# NEXT_PUBLIC_* is inlined into the browser bundle.
# LOG_* applies to Next.js server actions and API routes.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_LOG_LEVEL=DEBUG
NEXT_PUBLIC_LOG_JSON=false
LOG_LEVEL=DEBUG
LOG_HTTP_HEADERS=true
LOG_HTTP_BODIES=true
LOG_JSON=false

# -----------------------------------------------------------------------------
# Auth. Must match be/config/.env.local AUTH2_SECRET_KEY.
# -----------------------------------------------------------------------------
JWT_PUBLIC_OR_SECRET=f758477076a7141567778169335d176f7624f1800974d393c455998811574804



# -----------------------------------------------------------------------------
# Object storage (Cloudflare R2 and S3 compatible).
# Not plug-and-play for Google Cloud Storage; code changes are required.
# MEDIA_STORAGE=local serves branding at /api/local-media/... 
# short term solution for local development, will be replaced with google storage in future.
# -----------------------------------------------------------------------------
MEDIA_STORAGE=local
# Relative to the frontend app directory (fe/). Seed logos are committed here.
LOCAL_MEDIA_ROOT=./local-media

CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BUCKET_NAME=
R2_MEDIA_SERVER_WORKER_URL=
R2_PUBLIC_MEDIA_SERVER_WORKER_URL=


