# Copy to .env and fill in. NEVER commit real credentials — .env is gitignored.
#
# ST_* = system-test harness credentials (shared with test_st_api).
# Allure (allure.clinicle-ci.local) is the stable manual tenant — do not point these
# defaults at Allure. Disposable harness tenants are Test Org A / Test Org B.
#
# Hosts (add to /etc/hosts if missing — see README / seed README):
#   testorg-a.clinicle-ci.local, testorg-b.clinicle-ci.local,
#   admin.clinicle-ci.local, api.clinicle-ci.local


# Direct Postgres access for seeding + truth-oracle assertions (seed/db.ts).
ST_DATABASE_URL=postgresql://ci_user:ci_user@localhost:5432/ci_db

# Default password given to users created by the seed toolkit.
ST_SEED_PASSWORD=Password@123


# Super admin logs in on the platform host, not an org subdomain.
ST_SUPER_ADMIN_EMAIL=super.admin@clinicle.com
ST_SUPER_ADMIN_PASSWORD=Password@123
ST_SUPER_ADMIN_BASE_URL=https://admin.clinicle-ci.local
# Local DB schema (be/config/.env.local uses DB_SCHEMA=ci)
ST_DATABASE_SCHEMA=ci


# ---------------------------------------------------------------------------
# Target environment
# ---------------------------------------------------------------------------
PLAYWRIGHT_BASE_URL=https://testorg-a.clinicle-ci.local
ORG_DOMAIN=testorg-a.clinicle-ci.local
ST_USER_EMAIL=st+fixture-testorg-a-user@testorg-a.clinicle-test.com
ST_USER_PASSWORD=Password@123
ST_ORG_ADMIN_EMAIL=st+fixture-testorg-a-org-admin@testorg-a.clinicle-test.com
ST_ORG_ADMIN_PASSWORD=Password@123
ST_ORG_OWNER_EMAIL=st+fixture-testorg-a-org-owner@testorg-a.clinicle-test.com
ST_ORG_OWNER_PASSWORD=Password@123


# Test Org B — second tenant for cross-org isolation specs
ST_TENANT_B_DOMAIN=testorg-b.clinicle-ci.local
ST_TENANT_B_ORG_OWNER_EMAIL=st+fixture-testorg-b-org-owner@testorg-b.clinicle-test.com
ST_TENANT_B_ORG_OWNER_PASSWORD=Password@123
ST_TENANT_B_ORG_ADMIN_EMAIL=st+fixture-testorg-b-org-admin@testorg-b.clinicle-test.com
ST_TENANT_B_ORG_ADMIN_PASSWORD=Password@123
ST_TENANT_B_USER_EMAIL=st+fixture-testorg-b-user@testorg-b.clinicle-test.com
ST_TENANT_B_USER_PASSWORD=Password@123
